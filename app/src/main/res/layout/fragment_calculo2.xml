<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/div_mult_back"
    tools:context=".Calculo2">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progressoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_progresso"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp">

        <ImageView
            android:id="@+id/estrelaIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/estrela"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tvProgresso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7/10"
            android:textColor="#5C3A00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@id/estrelaIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vidasContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_progresso"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp">

        <ImageView
            android:id="@+id/coracao1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/coracao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/coracao2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/coracao"
            app:layout_constraintStart_toEndOf="@id/coracao1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="8dp"/>

        <ImageView
            android:id="@+id/coracao3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/coracao"
            app:layout_constraintStart_toEndOf="@id/coracao2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="8dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Divisão"
        android:textColor="@android:color/holo_orange_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>


    <TextView
        android:id="@+id/tvdNivel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nível 2"
        android:textColor="#5C3A00"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/textView8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <ProgressBar
        android:id="@+id/tvdBarraDiv"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="362dp"
        android:layout_height="0dp"

        android:layout_marginStart="16dp"

        android:layout_marginTop="16dp"

        android:layout_marginEnd="16dp"
        android:progress="50"
        android:progressDrawable="@android:drawable/progress_horizontal"

        android:progressTint="@android:color/holo_orange_dark"


        android:radius="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.468"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvdNivel" />

    <TableLayout
        android:id="@+id/tableLayout2"
        android:layout_width="331dp"
        android:layout_height="119dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_progresso"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvdBarraDiv">

        <TableRow android:gravity="center">

            <TextView
                android:paddingTop="12dp"
                android:text="QUANTO É?"
                android:textAlignment="center"
                android:textColor="#8B6B00"
                android:textSize="16sp"
                android:textStyle="bold" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <TextView
                android:id="@+id/tvdNumero1"
                android:layout_width="match_parent"
                android:paddingEnd="8dp"
                android:text="20"
                android:textAlignment="center"
                android:textColor="#6B4A00"
                android:textSize="48sp" />

            <TextView

                android:id="@+id/tvdOperador"
                android:layout_width="match_parent"
                android:paddingEnd="8dp"
                android:text="÷"
                android:textAlignment="center"
                android:textColor="#FF9800"
                android:textSize="48sp" />

            <TextView

                android:id="@+id/tvdNumero2"
                android:layout_width="79dp"

                android:layout_height="match_parent"
                android:paddingEnd="8dp"
                android:text="10"
                android:textAlignment="center"
                android:textColor="#6B4A00"
                android:textSize="48sp" />

            <TextView

                android:id="@+id/tvdIgual"
                android:layout_width="43dp"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:text="="
                android:textAlignment="center"
                android:textColor="#6B4A00"
                android:textSize="48sp" />

            <TextView

                android:id="@+id/tvdResultado"
                android:layout_width="29dp"
                android:text="?"
                android:textAlignment="center"
                android:textColor="#6B4A00"
                android:textSize="48sp" />
        </TableRow>


    </TableLayout>

    <TableLayout
        android:layout_width="320dp"
        android:layout_height="350dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tableLayout2">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <Button
                android:id="@+id/tvdOpcao4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/botao_verde" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <Button
                android:id="@+id/tvdOpcao3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/botao_rosa" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <Button
                android:id="@+id/tvdOpcao2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/botao_colorido" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="137dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/tvdOpcao1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/botao_azul" />
        </TableRow>
    </TableLayout>

    <Button
        android:id="@+id/tvdProxima"
        android:layout_width="217dp"
        android:layout_height="54dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/btn_orange"


        android:text="Próxima Pergunta"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.485"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
