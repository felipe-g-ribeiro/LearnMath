<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/div_mult_back"
    tools:context=".Calculo1">


    <TableLayout
        android:id="@+id/tableLayout2"
        android:layout_width="331dp"
        android:layout_height="119dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_progresso"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tituloMultiplicacao">

        <TableRow android:gravity="center">

            <TextView
                android:paddingTop="12dp"
                android:text="@string/how_much"
                android:textAlignment="center"
                android:textColor="#8B6B00"
                android:textSize="16sp"
                android:textStyle="bold" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <TextView
                android:id="@+id/tvM1"
                android:layout_width="match_parent"
                android:paddingEnd="8dp"
                android:text="20"
                android:textAlignment="center"
                android:textColor="#6B4A00"
                android:textSize="48sp" />

            <TextView

                android:id="@+id/tvdOperador"
                android:layout_width="match_parent"
                android:paddingEnd="8dp"
                android:text="X"
                android:textAlignment="center"
                android:textColor="#FF9800"
                android:textSize="48sp" />

            <TextView

                android:id="@+id/tvM2"
                android:layout_width="79dp"

                android:layout_height="match_parent"
                android:paddingEnd="8dp"
                android:text="10"
                android:textAlignment="center"
                android:textColor="#6B4A00"
                android:textSize="48sp" />

        </TableRow>


    </TableLayout>

    <TextView
        android:id="@+id/tituloMultiplicacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="@string/multiplication"
        android:textAllCaps="true"
        android:textColor="@color/purple_700"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/btnM1"
        android:layout_width="90dp"
        android:layout_height="60dp"
        android:layout_marginTop="71dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/btn_blue"
        android:textColor="#2D3748"
        android:textSize="22sp"
        app:layout_constraintEnd_toStartOf="@id/btnM2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tableLayout2" />


    <Button
        android:id="@+id/btnM2"
        android:layout_width="90dp"
        android:layout_height="60dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="71dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/btn_blue"
        android:textColor="#2D3748"
        android:textSize="22sp"
        app:layout_constraintEnd_toStartOf="@id/btnM3"
        app:layout_constraintStart_toEndOf="@id/btnM1"
        app:layout_constraintTop_toBottomOf="@+id/tableLayout2" />


    <Button
        android:id="@+id/btnM3"
        android:layout_width="90dp"
        android:layout_height="60dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="71dp"
        android:background="@drawable/btn_blue"
        android:textColor="#2D3748"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnM2"
        app:layout_constraintTop_toBottomOf="@+id/tableLayout2" />


    <Button
        android:id="@+id/btnNovoM"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/btn_green"
        android:text="@string/new_challenge"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnM2" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="90dp"
        android:layout_height="160dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/robo_feliz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnNovoM" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="90dp"
        android:layout_height="160dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/robo_try"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnNovoM" />

    <TextView
        android:id="@+id/txtIncentivo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="@string/test"
        android:textColor="#2D3748"
        android:textSize="48sp"

        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/imageView4"
        app:layout_constraintStart_toEndOf="@+id/imageView3"
        app:layout_constraintTop_toBottomOf="@+id/btnNovoM" />

    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="237dp"
        android:layout_height="56dp"
        android:layout_marginBottom="32dp"

        android:background="@drawable/bg_progresso"
        android:isIndicator="true"
        android:numStars="5"
        android:stepSize="1"
        android:theme="@style/RatingBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>
